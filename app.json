{
  "expo": {
    "name": "Лад",
    "slug": "lad-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lad.finance",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#234B3C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.lad.finance"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Лад — личные финансы",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#234B3C"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Лад использует Face ID для доступа к вашим финансовым данным."
        }
      ]
    ],
    "scheme": "lad",
    "description": "Личные финансы в вашем ритме: расходы, цели и понятный план."
  }
}
