@startuml
' Publication layout: use-case-diagrams.mjs; @row comments pair the nodes.
left to right direction
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 32
actor "Владелец" as Owner
rectangle "Лад" {
  package "UC-02. Вести счета, переводы и сверки" as U2 {
    usecase "Создать счёт\nи задать валюту" as A2_1
    ' @row A2_1
    usecase "Перевести деньги" as A2_2
    usecase "Проверить счета\nи доступную сумму" as D2_2
    ' @row A2_2 D2_2
    usecase "Сверить остаток" as A2_3
    usecase "Внести\nкорректировку" as D2_3
    ' @row A2_3 D2_3
  }
  package "UC-03. Вести операции и обмениваться файлами" as U3 {
    usecase "Записать доход\nили расход" as A3_1
    usecase "Проверить\nоперацию" as D3_1
    ' @row A3_1 D3_1
    usecase "Импортировать CSV" as A3_2
    usecase "Проверить пакет\nи найти повторы" as D3_2
    ' @row A3_2 D3_2
    usecase "Выгрузить\nоперации" as A3_3
    ' @row A3_3
  }
}
Owner -- A2_1
Owner -- A2_2
Owner -- A2_3
Owner -- A3_1
Owner -- A3_2
Owner -- A3_3
A2_2 ..> D2_2 : <<include>>
D2_3 ..> A2_3 : <<extend>>
A3_1 ..> D3_1 : <<include>>
A3_2 ..> D3_2 : <<include>>
' Extension point: resolving a reconciliation discrepancy.
' Condition: a discrepancy exists and the owner confirms an adjustment.
@enduml
