@startuml
' Publication layout: use-case-diagrams.mjs; @row comments pair the nodes.
left to right direction
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 32
actor "Владелец" as Owner
rectangle "Лад" {
  package "UC-04. Управлять категориями и бюджетами" as U4 {
    usecase "Настроить\nкатегории" as A4_1
    ' @row A4_1
    usecase "Задать бюджет" as A4_2
    usecase "Задать период\nи переносы" as D4_2
    ' @row A4_2 D4_2
  }
  package "UC-05. Вести цели и годовые фонды" as U5 {
    usecase "Создать цель\nили годовой фонд" as A5_1
    ' @row A5_1
    usecase "Пополнить цель" as A5_2
    usecase "Перевести деньги\nна накопления" as D5_2
    ' @row A5_2 D5_2
    usecase "Вывести средства" as A5_3
    usecase "Освободить сумму\nи перевести деньги" as D5_3
    ' @row A5_3 D5_3
    usecase "Записать оплату\nиз годового фонда" as A5_4
    usecase "Освободить фонд\nи записать расход" as D5_4
    ' @row A5_4 D5_4
  }
}
Owner -- A4_1
Owner -- A4_2
Owner -- A5_1
Owner -- A5_2
Owner -- A5_3
Owner -- A5_4
A4_2 ..> D4_2 : <<include>>
A5_2 ..> D5_2 : <<include>>
A5_3 ..> D5_3 : <<include>>
A5_4 ..> D5_4 : <<include>>
@enduml
