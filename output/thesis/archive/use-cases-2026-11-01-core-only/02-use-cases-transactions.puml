@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
actor "Владелец учёта" as Owner
rectangle "Мобильное приложение Лад" {
  usecase "UC-01\nЗаписать финансовую\nоперацию" as U1
  usecase "UC-02\nЗаписать перевод\nмежду счетами" as U2
  usecase "UC-03\nУчесть взнос\nв цель" as U3
  usecase "UC-04\nУчесть вывод\nиз цели" as U4
}
Owner -- U1
Owner -- U2
Owner -- U3
Owner -- U4
U2 --|> U1
U3 ..> U2 : <<include>>
U4 ..> U2 : <<include>>
@enduml
