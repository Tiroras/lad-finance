@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
actor "Владелец учёта" as Owner
rectangle "Мобильное приложение Лад" {
  usecase "UC-01\nОрганизовать\nи защитить\nличный учёт" as U1
  usecase "UC-02\nПоддерживать\nдостоверные остатки\nсчетов" as U2
  usecase "UC-03\nВести историю\nфинансовых операций" as U3
  usecase "UC-04\nКонтролировать\nрасходы по бюджету" as U4
  usecase "UC-05\nНакапливать средства\nна финансовую цель" as U5
  usecase "UC-06\nПланировать\nи учитывать доходы\nи платежи" as U6
  usecase "UC-07\nКонтролировать долги\nи кредитные\nобязательства" as U7
  usecase "UC-10\nАнализировать\nфинансовую историю" as U10
  usecase "UC-08\nПолучать прогноз\nденежных остатков" as U8
  usecase "UC-09\nОценивать покупку\nи изменения\nфинансового плана" as U9
}
Owner -- U1
Owner -- U2
Owner -- U3
Owner -- U4
Owner -- U5
Owner -- U6
Owner -- U7
Owner -- U10
Owner -- U8
Owner -- U9
U9 ..> U8 : <<include>>
@enduml
