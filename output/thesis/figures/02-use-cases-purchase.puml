@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
actor "Владелец учёта" as Owner
rectangle "Мобильное приложение Лад" {
  usecase "UC-08\nОценить\nвозможность покупки\n--\nТочка расширения\nоценка текущих трат" as U8
  usecase "UC-07\nПолучить прогноз\nденежных остатков" as U7
  usecase "Выявить дефицит\nи нарушение резерва" as H11
  usecase "Определить допустимую\nсумму и дату покупки" as H12
  usecase "Оценить дневную сумму\nпосле покупки" as H13
  usecase "Рассчитать доступную\nи дневную суммы" as H14
}
Owner -- U8
Owner -- U7
U8 ..> U7 : <<include>>
U7 ..> H11 : <<include>>
U8 ..> H12 : <<include>>
H13 ..> U8 : <<extend>>\n[дата покупки — сегодня]
H13 ..> H14 : <<include>>
@enduml
