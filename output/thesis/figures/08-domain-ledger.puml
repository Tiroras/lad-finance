@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam classAttributeIconSize 0
hide circle
hide methods
class "Счёт" as Account {
  вид: ВидСчёта
  валюта: Код
  /остаток: Деньги
}
class "Операция" as Transaction {
  вид: ВидОперации
  дата: Дата
  сумма: Деньги
  зачисление?: Деньги
  статус: Статус
}
class "Категория" as Category {
  название: Текст
  архив: Логика
}
class "Часть расхода" as Split {
  сумма: Деньги
}
class "Долг" as Debt {
  вид: взят / выдан
  /остаток: Деньги
}
class "Корректировка" as Adjustment {
  дата: Дата
  изменение: Деньги
}
class "Сверка" as Reconciliation {
  дата: Дата
  остаток: Деньги
}
Account "1" -- "0..*" Transaction : основной
Account "0..1" -- "0..*" Transaction : получатель
Category "1" -- "0..*" Transaction
Transaction "1" *-- "0..*" Split
Category "1" -- "0..*" Split
Account "1" -- "0..*" Debt : исходный
Debt "0..1" -- "0..*" Transaction
Account "1" -- "0..*" Adjustment
Account "1" -- "0..*" Reconciliation
Category "0..1" -- "0..*" Category : родитель / подкатегории
Transaction "0..1" -- "0..*" Transaction : покупка / возвраты
@enduml
