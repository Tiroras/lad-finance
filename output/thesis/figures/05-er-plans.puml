@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam classFontSize 19
skinparam classAttributeFontSize 18
skinparam ArrowFontSize 18
skinparam legendFontSize 18
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam ArrowColor black
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 22
hide circle

entity "План дохода" as Income {
  * id
  --
  название
}
entity "План платежа" as Payment {
  * id
  --
  название, категория
}
entity "Цель" as Goal {
  * id
  --
  целевая сумма
}
entity "Условия дохода" as IncomeTerms {
  * id
  --
  начало, конец?, сумма
}
entity "Условия платежа" as PaymentTerms {
  * id
  --
  начало, конец?, сумма
}
entity "Условия цели" as GoalTerms {
  * id
  --
  начало, конец?, взнос
}
entity "Счёт" as Account {
  * id
  --
  валюта
}
entity "Изменение" as Change {
  * сценарий
  * вид + ID источника
  --
  сумма, сдвиг
}
entity "Сценарий" as Scenario {
  * id
  --
  горизонт
}
entity "Разовое событие" as Event {
  * id
  --
  дата, вид, сумма
}

Income -[hidden]right- Payment
Payment -[hidden]right- Goal
IncomeTerms -[hidden]right- PaymentTerms
PaymentTerms -[hidden]right- GoalTerms
Account -[hidden]right- Change
Change -[hidden]right- Scenario
Income ||-down-o{ IncomeTerms
Payment ||-down-o{ PaymentTerms
Goal ||-down-o{ GoalTerms
Account ||-up-o{ IncomeTerms
Account ||-up-o{ PaymentTerms
Scenario ||--left--o{ Change : строки
Scenario ||-down-o{ Event
Account |o--o{ Event : назначение
GoalTerms -[hidden]down- Scenario

legend bottom
  Источник: план дохода, платежа или цель (0..1).
  Ноль версий допустим для старых данных.
  Вывод из цели: цель 1 ← 0..* освобождений → 1 перевод.
  Освобождение хранит дату, сумму и transferId.
  cycleId необязателен: без него самостоятельный вывод.
  Звёздочкой помечен ключ.
endlegend
@enduml
