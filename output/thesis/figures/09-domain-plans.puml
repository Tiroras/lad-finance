@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam classAttributeIconSize 0
hide circle
hide methods
class "План дохода" as Income {
  название: Текст
}
class "План платежа" as Payment {
  название: Текст
}
class "Цель" as Goal {
  целевая сумма: Деньги
  валюта: Код
  /накоплено: Деньги
}
class "Условия плана" as Terms {
  начало: Дата
  конец?: Дата
  сумма: Деньги
}
class "График" as Schedule {
  единица: Период
  интервал: Целое
  опорная дата: Дата
}
class "Цикл фонда" as FundCycle {
  дата платежа: Дата
  статус: СтатусЦикла
}
class "Освобождение накоплений" as Release {
  дата: Дата
  сумма: Деньги
}
class "Операция" as Transaction {
}
class "Уточнение дохода" as IncomeOverride {
  ожидается?: Дата
  пропуск: Логика
}
Income "0..1" *-- "1..*" Terms
Payment "0..1" *-- "1..*" Terms
Goal "0..1" *-- "1..*" Terms
Terms "1" *-- "0..1" Schedule
Income "1" *-- "0..*" IncomeOverride
Goal "1" -- "0..*" FundCycle
Goal "1" -- "0..*" Release
FundCycle "0..1" -- "0..1" Release
Transaction "1" -- "0..1" Release : перевод
Payment "0..1" -- "0..*" FundCycle : обязательство
Transaction "0..1" -- "0..1" FundCycle : оплата
Goal "0..1" -- "0..*" Transaction : взнос
@enduml
