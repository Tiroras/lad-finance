@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
actor "Владелец учёта" as Owner
rectangle "Мобильное приложение Лад" {
  usecase "UC-03\nУчесть взнос в цель" as U3
  usecase "Закрепить\nпереведённую сумму\nза целью" as H8
  usecase "Проверить финансовую\nсогласованность\nучёта" as H5
  usecase "UC-02\nЗаписать перевод\nмежду счетами" as U2
  usecase "UC-04\nУчесть вывод из цели" as U4
  usecase "Освободить сумму\nиз цели" as H9
}
Owner -- U3
Owner -- U4
U3 ..> U2 : <<include>>
U3 ..> H8 : <<include>>
U4 ..> U2 : <<include>>
U4 ..> H9 : <<include>>
U2 ..> H5 : <<include>>
@enduml
