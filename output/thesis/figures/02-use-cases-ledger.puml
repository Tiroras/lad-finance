@startuml
' Render with external Graphviz (not Smetana).
' Verified: PlantUML 1.2026.1 + Graphviz 16.1.0 (Viz.js 3.31.0 WASM).

top to bottom direction
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 28
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam usecaseFontSize 28
skinparam packageFontSize 28
skinparam actorFontSize 28
skinparam nodesep 16
skinparam ranksep 40

actor "Владелец" as Owner
rectangle "Система" {
  usecase "UC-01. Настроить\nлокальный учёт\nи профили" as U1
  usecase "UC-02. Вести счета\nи сверять остатки" as U2
  usecase "UC-03. Вести операции\nи ожидания" as U3
  usecase "UC-04. Записывать\nпереводы и обмен" as U4

  usecase "UC-05. Управлять\nкатегориями и бюджетами" as U5
  usecase "UC-06. Планировать\nи пополнять цели\nи годовые фонды" as U6
  usecase "UC-07. Планировать\nи отмечать доходы" as U7
  usecase "UC-08. Вести платежи,\nподписки и напоминания" as U8
  U1 -[hidden]down- U2
  U2 -[hidden]down- U3
  U3 -[hidden]down- U4
  U5 -[hidden]down- U6
  U6 -[hidden]down- U7
  U7 -[hidden]down- U8
  U1 -[hidden]right- U5
  U2 -[hidden]right- U6
  U3 -[hidden]right- U7
  U4 -[hidden]right- U8
}
Owner -right- U1
Owner -right- U2
Owner -right- U3
Owner -right- U4
Owner -right- U5
Owner -right- U6
Owner -right- U7
Owner -right- U8
@enduml
