{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "react"]
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/**/*",
    "tests/**/*",
    "playwright*.config.ts"
  ],
  "exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}
