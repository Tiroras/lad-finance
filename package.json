{
  "name": "lad-finance",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.6",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "~22.20.2",
    "@types/react": "~19.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:fresh": "EXPO_PUBLIC_RESET_ON_START=true expo start",
    "start:demo": "EXPO_PUBLIC_ENABLE_DEMO=true expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:fresh": "EXPO_PUBLIC_RESET_ON_START=true expo start --web",
    "web:demo": "EXPO_PUBLIC_ENABLE_DEMO=true expo start --web",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run test:e2e:demo && npm run test:e2e:personal && npm run test:e2e:fresh",
    "test:e2e:demo": "playwright test",
    "test:e2e:personal": "playwright test --config playwright.personal.config.ts",
    "test:e2e:fresh": "playwright test --config playwright.fresh.config.ts",
    "emulator": "node scripts/mobile.mjs emulator",
    "test:mobile": "node scripts/mobile.mjs test",
    "build": "expo export --platform all",
    "build:demo": "EXPO_PUBLIC_ENABLE_DEMO=true expo export --platform all",
    "format": "prettier --write App.tsx src tests scripts *.json *.ts docs/*.md README.md"
  },
  "private": true
}
